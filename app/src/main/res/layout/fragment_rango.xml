<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rango Movie Scene"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <ImageView
            android:id="@+id/imageRangoScene"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:src="@drawable/rango_scene"
            android:scaleType="centerCrop"
            android:contentDescription="Rango confronting Jake the Rattlesnake"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Rango faces Jake the Rattlesnake in a dangerous confrontation. Alongside Beans, Rango must find the courage to stand up against the threats facing the town of Dirt."
            android:textSize="16sp"
            android:textColor="@color/colorTextPrimary"
            android:lineSpacingExtra="5dp"/>

    </LinearLayout>

</ScrollView>